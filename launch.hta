<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Study for CA - Launcher</title>
<HTA:APPLICATION ID="StudyCA" APPLICATIONNAME="Study for CA Launcher" BORDER="thin" CAPTION="yes" SHOWINTASKBAR="yes" SINGLEINSTANCE="yes" SYSMENU="yes" WINDOWSTATE="normal" SCROLL="no" />
<style>
body { font-family: Segoe UI, Arial, sans-serif; background: #fdfcfa; color: #151515; margin: 0; padding: 24px; }
.card { max-width: 560px; margin: 0 auto; background: #fff; border: 1px solid #ddd; border-radius: 12px; padding: 24px; }
h1 { font-size: 22px; margin: 0 0 6px 0; color: #1b3a2e; }
p { font-size: 13px; color: #555; }
button { display: block; width: 100%; margin: 8px 0; padding: 12px; font-size: 14px; font-weight: bold; color: #fff; background: #1b3a2e; border: none; border-radius: 8px; cursor: pointer; }
button.ghost { background: #fff; color: #1b3a2e; border: 1px solid #1b3a2e; }
button:hover { filter: brightness(1.15); }
.small { font-size: 11px; color: #888; margin-top: 12px; }
</style>
<script language="VBScript">
Function HtaDir()
  Dim path
  path = Mid(document.location.href, 9)
  path = Replace(path, "/", "\")
  path = Unescape(path)
  HtaDir = Left(path, InStrRev(path, "\"))
End Function

Sub OpenBuilt()
  Dim sh
  Set sh = CreateObject("WScript.Shell")
  sh.Run Chr(34) & HtaDir() & "FOR_GITHUB\index.html" & Chr(34), 1, False
  Set sh = Nothing
End Sub

Sub StartDev()
  Dim sh
  Set sh = CreateObject("WScript.Shell")
  sh.Run "cmd /k " & Chr(34) & "cd /d " & Chr(34) & HtaDir() & "app" & Chr(34) & " && npm run dev" & Chr(34), 1, False
  Set sh = Nothing
End Sub

Sub OpenFolder()
  Dim sh
  Set sh = CreateObject("WScript.Shell")
  sh.Run Chr(34) & "explorer.exe" & Chr(34) & " " & Chr(34) & HtaDir() & Chr(34), 1, False
  Set sh = Nothing
End Sub
</script>
</head>
<body>
<div class="card">
<h1>Study for CA - the private study catalogue</h1>
<p>CA Intermediate Group II question bank (885 questions: Cost &amp; Mgmt, Auditing, FM &amp; SM). The ready-to-open built copy is <b>FOR_GITHUB\index.html</b>. For development, run the Vite app in <b>app\</b>.</p>
<button onclick="OpenBuilt">Open Built Catalogue (FOR_GITHUB\index.html)</button>
<button class="ghost" onclick="StartDev">Start Dev Server (app - npm run dev)</button>
<button class="ghost" onclick="OpenFolder">Open Project Folder</button>
<p class="small">Needs: any browser for the built copy. Dev server needs Node.js + npm install in app\. API key: copy app\.env.example to app\.env and fill VITE_NVIDIA_API_KEY.</p>
</div>
</body>
</html>
